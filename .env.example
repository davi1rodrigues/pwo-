# LiveKit Cloud project URL (wss://...) and credentials from the LiveKit dashboard
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Generate long random values; give each crew role a separate access code
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
DIRECTOR_CODE=replace-me
INTERVIEWER1_CODE=replace-me
INTERVIEWER2_CODE=replace-me
PRODUCER_CODE=replace-me
ROOM_NAME=pwo-formula-truck-2026
PORT=3000
# Optional, comma separated, for local LAN testing only. HTTPS hosting is required for mobile mic access.
ALLOWED_ORIGIN=http://localhost:5173

# Dedicated access code for the computer running OBS
OBS_CODE=replace-with-a-separate-random-code
