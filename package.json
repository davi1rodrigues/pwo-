{
  "name": "pwo-intercom",
  "version": "1.1.0",
  "description": "PWO team intercom desktop and web application",
  "author": "PWO",
  "productName": "PWO Intercom",
  "main": "electron-main.mjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "desktop": "npm run build && electron electron-main.mjs",
    "desktop:open": "electron electron-main.mjs",
    "desktop:package": "npm run build && electron-builder --win nsis",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:apk": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "mobile:open": "cap open android",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "concurrently": "^9.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.3",
    "obs-websocket-js": "^5.0.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.podpwo.intercom",
    "productName": "PWO Intercom",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.mjs",
      "server/**/*",
      "dist/**/*",
      "public/**/*",
      ".env.example",
      "package.json",
      "node_modules/**/*",
      "shared/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "PWO-Intercom-Setup-${version}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
